# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Custom redirect URL for Supabase auth (useful for development)
# If not set, defaults to {origin}/plan
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
